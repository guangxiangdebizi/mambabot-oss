# Copy to ~/.config/assistant-web/site.env (chmod 600) and adjust. Read by scripts/serve.sh,
# scripts/deploy.sh and scripts/rollback.sh. Every line is optional except LIVE_DIR for deploys.

# Node 22+ binary (default: `node` on PATH)
#NODE=/usr/local/bin/node
# Time zone for scheduled tasks (cron is evaluated in server local time)
TZ=Asia/Shanghai
AW_PORT=3400
# Public host names served through your reverse proxy (needed when the page is not on localhost)
AW_ALLOWED_HOSTS=example.com,www.example.com
# Optional: other MambaBot sites of yours, listed under Settings > switch site (quote the value)
#AW_ACCOUNT_LINKS="Main|https://example.com,Second|https://second.example.com"
# Optional: your own Claude accounts on this host, switchable under Settings > Claude account.
# Each is a Claude Code config directory signed in with `CLAUDE_CONFIG_DIR=<dir> claude` and /login;
# link its projects directory to ~/.claude/projects so chats carry over (see README).
#AW_CLAUDE_ACCOUNTS="Main|~/.claude,Second|~/.claude-second"
# Web images in replies are fetched by the server from public addresses only. If this host's DNS
# goes through a local proxy in fake-ip mode (every name resolves to 198.18.x.x), allow that range:
#AW_REMOTE_IMAGES_FAKE_IP=1
# Behind nginx on the same host: trust X-Real-IP and send Secure cookies
AW_TRUST_PROXY=1
AW_COOKIE_SECURE=1
# Optional live browser panel: BrowserOS AppImage (extracted AppRun) and its profile directory
#AW_BROWSER_BIN=$HOME/.local/opt/browseros/squashfs-root/AppRun
#AW_BROWSER_PROFILE=$HOME/.local/share/assistant-web/browser-profile

# scripts/deploy.sh and scripts/rollback.sh
LIVE_DIR=$HOME/mambabot-live
#BACKUPS=$HOME/backups
#NGINX_CONF=/etc/nginx/conf.d/example.com.conf
#NGINX_SITE=$HOME/.config/assistant-web/nginx-site.conf
#PUBLIC_URL=https://example.com
